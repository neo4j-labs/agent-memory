      "link": null,
      "locked": false,
      "text": "add_relationship(person, company, \"WORKS_AT\") stores the logical name in RELATED_TO.type.\nAutomatic message extraction instead sets the separate RELATED_TO.relation_type property.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "add_relationship(person, company, \"WORKS_AT\") stores the logical name in RELATED_TO.type.\nAutomatic message extraction instead sets the separate RELATED_TO.relation_type property.",
