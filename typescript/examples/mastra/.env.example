# Neo4j Agent Memory Service API key — get one at https://memory.neo4jlabs.com
MEMORY_API_KEY=nams_your_key_here

# The Mastra agent needs a model provider. OpenAI is the default.
OPENAI_API_KEY=sk-your_key_here

# Optional: any Mastra model-router id ("<provider>/<model>").
# MASTRA_MODEL=openai/gpt-5-mini

# Optional: the resource (user) id both threads are created under.
# DEMO_USER_ID=mastra-demo-user

# Optional: delete both threads on the way out so re-runs stay idempotent.
# CLEANUP=1
