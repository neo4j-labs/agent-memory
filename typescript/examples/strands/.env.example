# Neo4j Agent Memory Service API key. Get one at https://memory.neo4jlabs.com
MEMORY_API_KEY=nams_your_key_here

# Which model provider the agent uses: openai (default) or bedrock.
MODEL_PROVIDER=openai

# --- MODEL_PROVIDER=openai ---------------------------------------------------
OPENAI_API_KEY=sk-your_key_here
OPENAI_MODEL=gpt-5-mini

# --- MODEL_PROVIDER=bedrock (Strands' first-class pairing) -------------------
# Credentials come from the usual AWS chain (AWS_PROFILE, SSO, instance role),
# so only the region and the model id are set here. Nothing to uncomment in the
# source: src/index.ts selects the provider from MODEL_PROVIDER.
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6

# Who the conversation belongs to. Re-running with the same value resumes the
# newest conversation this example wrote for that user.
DEMO_USER_ID=strands-demo-user

# Resume one specific conversation instead of the newest one. The script prints
# the id to use here at the end of every run.
# CONVERSATION_ID=
