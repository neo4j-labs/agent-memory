# Required. A workspace-scoped data-plane key from https://memory.neo4jlabs.com
# — not an admin key. Rotate with client.auth.rotateApiKey().
MEMORY_API_KEY=nams_your_key_here

# Optional: "stdio" (default, for Claude Desktop and IDE plugins) or "http"
# (Streamable HTTP, for a client that is not co-located with this process).
# MCP_TRANSPORT=stdio
# MCP_PORT=3000

# Optional: comma-separated allow-list. Only these tools are advertised and
# only these can be called. Unset means the full surface.
# MCP_TOOLS=memory_get_context,memory_search_entities

# Optional: set to 0 to drop the read-only Cypher tool. Leave it on only for
# clients you are willing to let query the graph directly.
# MCP_ENABLE_CYPHER=1
