# Settings for the standalone my-memory-mcp tutorial project.
# Use a workspace-scoped data key for a dedicated NAMS test workspace.
MEMORY_API_KEY=nams_your_workspace_key_here
MEMORY_ENDPOINT=https://memory.neo4jlabs.com/v1

# Leave unset with the workspace key above; do not reuse another workspace's
# selector. Desktop needs the same explicit values in its private env block.
# MEMORY_WORKSPACE_ID=

# No OpenAI key is required by this local stdio server.
# Keep the private .env and .tutorial-state/ directory out of version control.
