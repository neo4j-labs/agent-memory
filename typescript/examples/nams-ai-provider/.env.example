# Neo4j Agent Memory Service API key. Get one at https://memory.neo4jlabs.com
MEMORY_API_KEY=nams_your_key_here

# OpenAI key used by the @ai-sdk/openai model in these examples.
OPENAI_API_KEY=sk-your_key_here

# Optional: hosted endpoint override. Defaults to https://memory.neo4jlabs.com/v1
# MEMORY_ENDPOINT=

# Optional: workspace id, for API keys with access to more than one workspace.
# MEMORY_WORKSPACE_ID=

# Optional: owner of the demo conversations. Defaults to a per-script demo user.
# NAMS_DEMO_USER=

# Optional: model id passed to openai(). Defaults to gpt-5.4-mini.
# NAMS_DEMO_MODEL=gpt-5.4-mini
