# Neo4j Agent Memory Service API key — get one at https://memory.neo4jlabs.com
MEMORY_API_KEY=nams_your_key_here

# The agent needs a model provider. OpenAI is the default.
OPENAI_API_KEY=sk-your_key_here

# Optional: override the model (any @langchain/openai chat model id).
# OPENAI_MODEL=gpt-5-mini

# Optional: the user id new conversations are created under.
# DEMO_USER_ID=langchain-demo
