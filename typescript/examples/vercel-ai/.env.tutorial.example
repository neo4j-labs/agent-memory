# Settings for src/tutorials/*.ts, not the separate npm start demo.
# Get a workspace-scoped data key for a dedicated test workspace.
MEMORY_API_KEY=nams_your_workspace_key_here
MEMORY_ENDPOINT=https://memory.neo4jlabs.com/v1

# A workspace key already identifies its workspace. Leave this unset for that
# path; do not copy a workspace selector from another environment.
# MEMORY_WORKSPACE_ID=

# Only the first-agent and conversation recall lessons call OpenAI.
# OPENAI_API_KEY=sk-your_key_here
OPENAI_MODEL=gpt-4o-mini

# Retain each lesson's state file and returned conversation ID for later phases.
# The tutorials do not use DEMO_USER_ID or select the newest conversation.
