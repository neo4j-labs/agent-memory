# Neo4j Agent Memory Service API key. Get one at https://memory.neo4jlabs.com
MEMORY_API_KEY=nams_your_key_here

# OpenAI key used by the @ai-sdk/openai provider in this example.
OPENAI_API_KEY=sk-your_key_here

# Optional: model id passed to openai(). Defaults to gpt-5-mini.
# OPENAI_MODEL=gpt-5-mini

# Optional: owner of the conversation. Defaults to vercel-ai-demo-user.
# DEMO_USER_ID=vercel-ai-demo-user

# Optional: resume a specific conversation instead of the newest one this
# example created. The script prints the id to re-run with.
# CONVERSATION_ID=
