# Copy to .env (or export these) before running main.py.
# The repo's Docker Neo4j (`make neo4j-start`) uses these exact values.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=test-password

# No LLM or embedding key is needed: the demo runs with llm=None and a local
# sentence-transformers embedder.

# MEMORY_API_KEY is deliberately NOT read by this example — build_settings()
# pins backend="bolt", so a key left in your environment cannot redirect these
# writes to hosted NAMS (where preference/fact recall is unavailable). Use
# Neo4jMemoryStore.for_nams() for the hosted path.
# MEMORY_API_KEY=nams_xxxxxxxxxxxxxxxx

# Only used by the README's real-agent snippet, never by main.py. Verify with:
#   aws bedrock list-inference-profiles
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
# BEDROCK_INFERENCE_PROFILE_PREFIX=us
