# Neo4j for the bolt ontology lifecycle. Use a dedicated database: the run
# leaves the support-desk ontology (strict) active, and every client that
# connects with use_active_ontology=True (the default) extracts against it.
#
# These values match the throwaway container `make neo4j-start` launches.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=test-password
# NEO4J_DATABASE=neo4j

# Optional: any sentence-transformers model id for the local embedder.
# LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
