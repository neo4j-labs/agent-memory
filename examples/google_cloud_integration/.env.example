# Neo4j connection (used when MEMORY_API_KEY is not set)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password-here
NEO4J_DATABASE=neo4j

# --- Hosted backend (optional) ---------------------------------------
# Set MEMORY_API_KEY to run against the hosted Neo4j Agent Memory Service
# instead of your own Neo4j. Embeddings and entity extraction then run
# server-side. Note: when it is set, the NEO4J_* values above are ignored
# and the bolt-only phases (buffered writes, consolidation) are skipped.
# MEMORY_API_KEY=nams_your-key-here
# MEMORY_ENDPOINT=https://memory.neo4jlabs.com

# --- Google Cloud (optional; only the Vertex phases need it) ---------
# GOOGLE_CLOUD_PROJECT=your-project-id
# VERTEX_AI_LOCATION=us-central1

# --- Embeddings (pick one) -------------------------------------------
# 1. Vertex AI (needs GOOGLE_CLOUD_PROJECT above):
# EMBEDDING_PROVIDER=vertex_ai
# EMBEDDING_MODEL=gemini-embedding-001
#
# 2. OpenAI:
# OPENAI_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-small
# MEMORY_LLM=openai/gpt-5-mini
#
# 3. Nothing: with no credentials the scripts use a local
#    sentence-transformers embedder and a local spaCy/GLiNER extractor
#    (pip install "neo4j-agent-memory[extraction,sentence-transformers]").
# LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- MCP server (optional) -------------------------------------------
# Streamable HTTP is served at /mcp/; `sse` is deprecated.
MCP_PORT=8080
MCP_TRANSPORT=stdio
