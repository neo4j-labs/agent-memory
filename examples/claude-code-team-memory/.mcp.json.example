{
  "mcpServers": {
    "team-memory": {
      "type": "http",
      "url": "https://mcp.memory.neo4jlabs.com/mcp"
    },
    "team-memory-self-hosted": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "neo4j-agent-memory[mcp,openai]==0.6.0",
        "neo4j-agent-memory",
        "mcp",
        "serve",
        "--backend",
        "bolt",
        "--transport",
        "stdio",
        "--profile",
        "core",
        "--session-strategy",
        "per_day"
      ],
      "env": {
        "NEO4J_URI": "${NEO4J_URI}",
        "NEO4J_USER": "${NEO4J_USERNAME}",
        "NEO4J_PASSWORD": "${NEO4J_PASSWORD}",
        "MCP_USER_ID": "${USER}",
        "NEO4J_DATABASE": "${NEO4J_DATABASE:-neo4j}",
        "OPENAI_API_KEY": "${OPENAI_API_KEY}"
      }
    }
  }
}
