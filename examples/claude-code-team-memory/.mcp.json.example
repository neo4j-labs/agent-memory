{
  "mcpServers": {
    "team-memory": {
      "type": "http",
      "url": "https://mcp.memory.neo4jlabs.com/mcp"
    },
    "team-memory-self-hosted": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "neo4j-agent-memory[mcp]",
        "neo4j-agent-memory",
        "mcp",
        "serve",
        "--transport",
        "stdio",
        "--profile",
        "core",
        "--session-strategy",
        "per_day"
      ],
      "env": {
        "NEO4J_URI": "${NEO4J_URI:-bolt://localhost:7687}",
        "NEO4J_USER": "${NEO4J_USER:-neo4j}",
        "NEO4J_PASSWORD": "${NEO4J_PASSWORD}",
        "MCP_USER_ID": "${USER}"
      }
    }
  }
}
