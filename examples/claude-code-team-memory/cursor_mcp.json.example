{
  "mcpServers": {
    "team-memory": {
      "url": "https://mcp.memory.neo4jlabs.com/mcp",
      "headers": {
        "Authorization": "Bearer REPLACE_WITH_YOUR_NAMS_KEY"
      }
    },
    "team-memory-self-hosted": {
      "command": "uvx",
      "args": [
        "--from",
        "neo4j-agent-memory[mcp,openai]==0.6.0",
        "neo4j-agent-memory",
        "mcp",
        "serve",
        "--backend",
        "bolt",
        "--transport",
        "stdio",
        "--profile",
        "core",
        "--session-strategy",
        "per_day"
      ],
      "env": {
        "NEO4J_URI": "neo4j+s://REPLACE_WITH_YOUR_INSTANCE_ID.databases.neo4j.io",
        "NEO4J_USER": "neo4j",
        "NEO4J_PASSWORD": "REPLACE_WITH_YOUR_NEO4J_PASSWORD",
        "MCP_USER_ID": "REPLACE_WITH_YOUR_NAME",
        "NEO4J_DATABASE": "neo4j",
        "OPENAI_API_KEY": "REPLACE_WITH_YOUR_OPENAI_API_KEY"
      }
    }
  }
}
