# Copy to .env in THIS directory (the app root). The backend loads
# ../.env first, then backend/.env as an optional developer override.
#   cp .env.example .env

# ── Gemini credentials: pick ONE of the two paths ────────────────────

# Option A — Google AI Studio (simplest; no GCP project needed for the LLM).
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key

# Option B — Vertex AI. Leave GOOGLE_API_KEY unset, run
# `gcloud auth application-default login`, and set the project below.
# The backend then exports GOOGLE_GENAI_USE_VERTEXAI / GOOGLE_CLOUD_LOCATION
# for google-genai itself; set the flag explicitly to force this path.
GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_GENAI_USE_VERTEXAI=true

# ── Models ───────────────────────────────────────────────────────────

VERTEX_AI_LOCATION=us-central1
# Gemini model for the supervisor, all four specialists, and entity extraction
VERTEX_AI_MODEL_ID=gemini-2.5-flash
# text-embedding-004 and the gecko models were retired; gemini-embedding-001
# is current. 768 truncates its native 3072 dimensions, which keeps the Neo4j
# vector indexes the same shape as graphs built before the retirement.
VERTEX_AI_EMBEDDING_MODEL=gemini-embedding-001
VERTEX_AI_EMBEDDING_DIMENSIONS=768

# ── Neo4j ────────────────────────────────────────────────────────────
# Aura:  neo4j+s://xxxx.databases.neo4j.io
# Local: bolt://localhost:7687 with password `password` (see docker-compose.yml)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# ── Agent memory features ────────────────────────────────────────────
# Extraction needs one of the Gemini credentials above; with neither, it is
# disabled explicitly and the startup log says so.
MEMORY_ENABLE_EXTRACTION=true
MEMORY_ENABLE_DEDUPLICATION=true
MEMORY_DEDUP_AUTO_MERGE_THRESHOLD=0.95
MEMORY_DEDUP_FLAG_THRESHOLD=0.85

# ── Application ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
