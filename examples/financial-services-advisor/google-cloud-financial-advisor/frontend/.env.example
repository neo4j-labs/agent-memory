# Frontend build-time configuration (Vite inlines VITE_* at build time).
# Copy to .env and edit. Never commit real secrets — this SPA holds none.

# Where the browser should send API calls.
# Leave unset (or empty) to use the relative /api path, which works with:
#   - `npm run dev`       → the Vite dev proxy (see vite.config.ts)
#   - docker compose      → nginx proxying /api to the backend container
# Set an absolute URL when the SPA is deployed on its own (e.g. Cloud Run):
#   VITE_API_BASE_URL=https://financial-advisor-backend-xxxxx.run.app/api
VITE_API_BASE_URL=

# Dev-server-only: where `npm run dev` proxies /api to.
# Defaults to http://localhost:8000 (the backend's `make run-backend` port).
VITE_DEV_PROXY_TARGET=http://localhost:8000
