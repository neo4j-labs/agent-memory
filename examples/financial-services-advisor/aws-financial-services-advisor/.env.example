# Copy to backend/.env and fill in. Never commit the filled-in file.

# ── Neo4j ────────────────────────────────────────────────────────────
# Aura, a local container, or anything you can reach over bolt. The loader
# accepts NEO4J_USERNAME too, which is the name the library and the rest of
# this repo use.
NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Under the CDK deployment the credentials above come from Secrets Manager
# instead, via the secret ARN the compute stack injects:
# NEO4J_SECRET_ARN=arn:aws:secretsmanager:us-east-1:...:secret:financial-services-advisor/neo4j-credentials

# ── AWS ──────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
# Prefer AWS_PROFILE (or an instance / task role in deployment). Static keys
# are a last resort: they end up in a file on disk and in your shell history.
AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Amazon Bedrock ───────────────────────────────────────────────────
# Current Claude models are invoked through a cross-region inference profile,
# not a bare foundation-model id. Leave these unset to take the defaults from
# the library's `integrations.strands.bedrock_llm_model()` /
# `bedrock_embedding_model()` helpers, which track the current generation.
# Confirm what your account can invoke with:
#   aws bedrock list-inference-profiles
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
# BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# Region prefix for the inference profile: us | eu | apac | global
# BEDROCK_INFERENCE_PROFILE_PREFIX=us

# ── Amazon Cognito (deployed stack only) ─────────────────────────────
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# ── Application ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEBUG=false
# Start the API even when Neo4j is unreachable. Off by default so a bad
# NEO4J_URI fails loudly instead of producing a server that 503s every route.
ALLOW_DEGRADED_START=false

# ── S3 (document storage) ────────────────────────────────────────────
S3_BUCKET_NAME=financial-advisor-documents
S3_REGION=us-east-1

# ── Feature flags ────────────────────────────────────────────────────
ENABLE_SANCTIONS_CHECK=true
ENABLE_PEP_CHECK=true
ENABLE_ADVERSE_MEDIA=true
