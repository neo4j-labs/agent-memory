# Copy to .env and fill in your own values:
#   cp .env.example .env
#
# Never commit .env — it is ignored by the repository root .gitignore.

# --- Neo4j (required) -------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Required. The backend refuses to start without it — there is no default.
NEO4J_PASSWORD=

# --- OpenAI -----------------------------------------------------------------
# Required for the chat agent, for memory embeddings, and for product vector
# search. Without it the app still starts: product search falls back to text
# matching and /chat returns a clear error.
OPENAI_API_KEY=
# Chat model used by the Agent Framework client.
OPENAI_MODEL=gpt-5-mini
# Embedding model. 1536 dimensions, matching the product_embedding vector index
# created by `python -m data.load_products`. Change both or neither.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Azure OpenAI (alternative to OPENAI_API_KEY) ---------------------------
# At agent-framework 1.x GA, Azure routing uses the same OpenAIChatClient:
# setting an endpoint switches the client to Azure.
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
# AZURE_OPENAI_API_VERSION=

# --- Demo identity ----------------------------------------------------------
# Used by the PER_DAY session strategy when a request omits user_id.
DEFAULT_USER_ID=guest
