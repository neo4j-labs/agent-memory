# ---------------------------------------------------------------------------
# Neo4j — required, no defaults in code.
# These match ../docker-compose.yml (`make neo4j`). Change both together.
# Use a database dedicated to this demo: the seed activates the support-desk
# ontology, and activation is per database.
# ---------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=test-password
NEO4J_DATABASE=neo4j

# ---------------------------------------------------------------------------
# Agent
# Any PydanticAI model string. `openai:` selects the OpenAI Responses API and
# needs OPENAI_API_KEY; other providers need their pydantic-ai-slim extra.
#
# AGENT_MODEL=test selects PydanticAI's TestModel: keyless, it calls every tool
# once with placeholder arguments and answers with a JSON dump of the results.
# Use it for smoke tests and CI. It is NOT a real agent.
# ---------------------------------------------------------------------------
AGENT_MODEL=openai:gpt-5-mini
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Memory layer — runs locally, no API key.
# GLiNER2.5 (~407 MB) extracts against the active ontology; this embedder
# (~90 MB) embeds messages, entities and reasoning-trace tasks. Both download
# once on first use and are cached.
# ---------------------------------------------------------------------------
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
