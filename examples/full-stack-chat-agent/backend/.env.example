# ---------------------------------------------------------------------------
# Memory graph (neo4j-agent-memory)
# These defaults match ../docker-compose.yml. Change all four together.
# ---------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# ---------------------------------------------------------------------------
# News graph (the read-only domain graph the agent queries with its own driver)
# Defaults to the same container as the memory graph: run
#   uv run python scripts/load_news_sample.py
# to seed ~16 sample articles. Point this at your own Neo4j to use a real
# news graph instead — use a READ-ONLY database user.
# ---------------------------------------------------------------------------
NEWS_GRAPH_URI=bolt://localhost:7687
NEWS_GRAPH_USERNAME=neo4j
NEWS_GRAPH_PASSWORD=password
NEWS_GRAPH_DATABASE=neo4j

# Embedding model used for news vector search. Must match the model the
# `article_embeddings` index was built with (the seed script uses this value).
NEWS_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...

# PydanticAI model string for the chat agent. `openai:` selects the OpenAI
# Responses API; use `openai-chat:` for Chat Completions. Other providers need
# the matching pydantic-ai-slim extra (see pyproject.toml).
AGENT_MODEL=openai:gpt-5-mini

# ---------------------------------------------------------------------------
# Entity extraction for long-term memory
#   local = spaCy + GLiNER (no API cost; downloads models on first use)
#   llm   = spaCy + LLM fallback (needs OPENAI_API_KEY, no model download)
#   none  = disable extraction (long-term memory keeps only preferences/facts)
# ---------------------------------------------------------------------------
EXTRACTION_MODE=local

# ---------------------------------------------------------------------------
# Optional: swap the memory library's LLM / embedding provider.
# Leave empty to use the OpenAI defaults.
#   LLM_MODEL=anthropic/claude-sonnet-4-5
#   EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
#   ANTHROPIC_API_KEY=sk-ant-...
# ---------------------------------------------------------------------------
LLM_MODEL=
EMBEDDING_MODEL=

# ---------------------------------------------------------------------------
# Bounds on the agent-authored Cypher tool
# ---------------------------------------------------------------------------
CYPHER_TIMEOUT_SECONDS=15
CYPHER_MAX_ROWS=100

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=true
CORS_ORIGINS=http://localhost:3000
