# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# ============================================================================
# OpenAI Configuration (REQUIRED)
# ============================================================================
# REQUIRED: OpenAI API key for embeddings and LLM features
# Get your API key from: https://platform.openai.com/api-keys
# 
# The application will not start without this key. It is used for:
#   • Text embeddings (semantic search over conversations and entities)
#   • LLM-based entity extraction and enrichment
#   • Agent reasoning and tool use
#
OPENAI_API_KEY=sk-...

# Entity Enrichment Configuration
# Automatically enrich entities with data from Wikipedia and Diffbot
ENRICHMENT_ENABLED=true
# Optional: Diffbot API key for richer entity data
# DIFFBOT_API_KEY=your-diffbot-api-key

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true
CORS_ORIGINS=http://localhost:3000
