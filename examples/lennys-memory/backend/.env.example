# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# OpenAI Configuration
OPENAI_API_KEY=sk-...

# Chat agent model (PydanticAI model string). On PydanticAI 2.x the `openai:`
# prefix selects the Responses API; use `openai-chat:` for Chat Completions.
AGENT_MODEL=openai:gpt-5-mini

# Provider Configuration for extraction + embeddings (v0.3+)
# Default is OpenAI for both. To run extraction on Anthropic and embeddings on
# local sentence-transformers (no OpenAI dependency), set:
#   LLM_MODEL=anthropic/claude-sonnet-4-5
#   EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
#   ANTHROPIC_API_KEY=sk-ant-...
# Use the SAME embedding model here that you used when loading transcripts --
# mixing embedding spaces silently collapses recall. See
# docs: how-to/bring-your-own-model
LLM_MODEL=openai/gpt-5-mini
EMBEDDING_MODEL=openai/text-embedding-3-small
# ANTHROPIC_API_KEY=sk-ant-...

# Entity Enrichment Configuration
# Automatically enrich entities with data from Wikipedia and Diffbot
ENRICHMENT_ENABLED=true
# Optional: Diffbot API key for richer entity data
# DIFFBOT_API_KEY=your-diffbot-api-key

# Server Configuration
HOST=0.0.0.0
PORT=8000
# DEBUG=true turns on uvicorn auto-reload. Leave it off for deployments.
DEBUG=false
CORS_ORIGINS=http://localhost:3000
# Optional regex for preview deployments, e.g. https://.*\.vercel\.app
# CORS_ORIGIN_REGEX=
