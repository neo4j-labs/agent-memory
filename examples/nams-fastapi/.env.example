# NAMS (hosted backend) — get a key at https://memory.neo4jlabs.com
MEMORY_API_KEY=nams_xxxxxxxxxxxxxxxx

# MEMORY_WORKSPACE_ID=ws_xxxxxxxx              # required by header-scoped
#                                              # deployments (dev/staging);
#                                              # production keys encode the
#                                              # workspace themselves
# MEMORY_ENDPOINT=https://nams.internal/v1     # optional: private deployment

# Transport knobs (NamsConfig) — defaults shown
# MEMORY_TIMEOUT=30
# MEMORY_MAX_RETRIES=3
# MEMORY_VALIDATE_ON_CONNECT=1                 # 0 to skip the boot-time probe

# Dev only: accept an unauthenticated X-User-Id header as the tenant key so the
# README's curl works without an identity provider. Never set this in production.
# ALLOW_INSECURE_USER_HEADER=1
