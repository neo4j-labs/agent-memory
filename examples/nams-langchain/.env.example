# NAMS (hosted backend) — get a key at https://memory.neo4jlabs.com
MEMORY_API_KEY=nams_xxxxxxxxxxxxxxxx
# MEMORY_WORKSPACE_ID=ws_xxxxxxxx              # optional: pin a workspace
# MEMORY_ENDPOINT=https://nams.internal/v1     # optional: private deployment

# OpenAI — optional. Without it the script runs a scripted offline chat model
# and still exercises the full memory path against NAMS.
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-5-mini
