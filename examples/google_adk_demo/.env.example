# Neo4j connection (used when MEMORY_API_KEY is not set)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password-here
NEO4J_DATABASE=neo4j

# --- Hosted backend (optional) ---------------------------------------
# Set MEMORY_API_KEY to run the same demo against the hosted Neo4j Agent
# Memory Service instead of your own Neo4j. Embeddings and entity
# extraction then run server-side, so no OPENAI_API_KEY is needed.
# Note: when MEMORY_API_KEY is set, the NEO4J_* values above are ignored.
# MEMORY_API_KEY=nams_your-key-here
# MEMORY_ENDPOINT=https://memory.neo4jlabs.com

# --- Google ADK model (optional) -------------------------------------
# Without a key the demo drives the same ADK Runner with a scripted
# stand-in model, so it still runs offline.
# GOOGLE_API_KEY=your-gemini-api-key
# ADK_MODEL=gemini-2.5-flash
# ADK_USER_ID=demo-user

# --- Embeddings / extraction (pick one) ------------------------------
# 1. Hosted OpenAI models:
# OPENAI_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-small
# MEMORY_LLM=openai/gpt-5-mini
#
# 2. Or nothing at all: with no OPENAI_API_KEY the demo uses a local
#    sentence-transformers embedder and a local spaCy/GLiNER extraction
#    pipeline (pip install "neo4j-agent-memory[extraction,sentence-transformers]").
# LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
