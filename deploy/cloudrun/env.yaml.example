# Environment file for the local smoke test of the Cloud Run image.
#
# Despite the .yaml suffix this is a KEY=VALUE file for `docker run --env-file`.
# Copy it outside the repository (for example to test-memory.env), fill in the
# values from your Aura credentials file, and keep the copy private. See
# deploy/cloudrun/README.md, section 1.
#
# The deployed service reads NEO4J_URI, NEO4J_USER and NEO4J_PASSWORD from
# Secret Manager instead (README, section 2), and Cloud Build supplies
# GOOGLE_CLOUD_PROJECT.
#
# The image selects Vertex AI embeddings (gemini-embedding-001, 768 dimensions,
# location us-central1) and disables automatic extraction, so it needs no
# OpenAI key.

# AuraDB connection. Copy the Aura credentials file's NEO4J_USERNAME value into
# NEO4J_USER, the key the MCP CLI reads.
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-your-Aura-password
NEO4J_DATABASE=neo4j

# Google Cloud project used for Vertex AI embeddings. The README's docker run
# command also passes it with -e; either place works.
GOOGLE_CLOUD_PROJECT=your-test-project
